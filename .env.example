// Development fallback for local testing only
const DEV_FALLBACK_URL = "http://localhost:5082";

// Validate and get API base URL
function getApiBaseUrl(): string {
  const envUrl = process.env.NEXT_PUBLIC_API_BASE_URL;
  
  if (envUrl && envUrl.trim() !== "") {
    return envUrl.trim();
  }
  
  // Build-time or development fallback
  console.warn("[API] NEXT_PUBLIC_API_BASE_URL not set, using fallback:", DEV_FALLBACK_URL);
  return DEV_FALLBACK_URL;
}

export const API_BASE_URL = getApiBaseUrl();

// Runtime production validation (only in browser, not during build)
if (typeof window !== "undefined" && process.env.NODE_ENV === "production") {
  const envUrl = process.env.NEXT_PUBLIC_API_BASE_URL;
  if (!envUrl || envUrl.trim() === "") {
    console.error(
      "CRITICAL: NEXT_PUBLIC_API_BASE_URL environment variable is not set in production. " +
      "Please configure it in Vercel Project Settings -> Environment Variables."
    );
  }
}

// Diagnostic logging in development
if (process.env.NODE_ENV === "development" && typeof window !== "undefined") {
  console.log("[API] Base URL configured:", API_BASE_URL);
  console.log("[API] Environment:", process.env.NODE_ENV);
}
